# ─────────────────────────────────────────────────────────────────────────────
# Leimarembi Foundation Backend — Environment Variables Template
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (Development):
DATABASE_URL="file:./dev.db"
# PostgreSQL (Production — Required for full production deployment):
# DATABASE_URL="postgresql://user:password@host:5432/leimarembi_foundation?schema=public&sslmode=require"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Authentication ───────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION — Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_64_BYTE_HEX_STRING"
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://leimarembifoundation.org,https://www.leimarembifoundation.org

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000        # 15 minutes in milliseconds
RATE_LIMIT_AUTH_MAX=10             # Max auth attempts per window (login/register)
RATE_LIMIT_API_MAX=200             # Max general API requests per window

# ─── Payment / Webhook ────────────────────────────────────────────────────────
# Webhook secret for Razorpay HMAC verification
WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# ─── Cloudflare R2 / AWS S3 Object Storage (Private Documents) ───────────────
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="lfa-production-documents"
R2_ENDPOINT="https://your_cloudflare_account_id.r2.cloudflarestorage.com"
