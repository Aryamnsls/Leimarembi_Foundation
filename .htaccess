# Hostinger Web Server Configuration for Leimarembi Foundation
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Rewrite /website or /website/ directly to root index.html with QSA
    RewriteRule ^website/?$ /index.html [QSA,L]
    RewriteRule ^website/(.*)$ /$1 [QSA,L]

    # Ensure query string (like ?qr=1) is passed through
    RewriteCond %{QUERY_STRING} (^|&)qr= [NC]
    RewriteRule ^$ index.html [QSA,L]

    # Handle static files and existing directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all incoming requests to index.html with QSA
    RewriteRule ^ index.html [QSA,L]
</IfModule>

# Security: Prevent directory listing safely
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
