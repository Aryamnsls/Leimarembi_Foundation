# PWA response headers: keep the worker/manifest fresh so deployments propagate safely.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "^(sw\.js|manifest\.webmanifest|offline\.html)$">
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "^(icon-192|icon-512|icon-maskable-512|apple-touch-icon)\.png$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# Hostinger Web Server Configuration for Leimarembi Foundation Website
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Preserve ?qr=1 query parameter
    RewriteCond %{QUERY_STRING} (^|&)qr= [NC]
    RewriteRule ^$ index.html [QSA,L]

    # Serve static assets if they exist
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Fallback to index.html for Next.js routes
    RewriteRule ^ index.html [QSA,L]
</IfModule>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
